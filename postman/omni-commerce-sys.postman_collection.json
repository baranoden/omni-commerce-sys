    {
      "name": "Orders",
      "item": [
        {
          "name": "POST /orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const orderId = json?.data?.id;",
                  "if (orderId) {",
                  "  pm.collectionVariables.set('orderId', String(orderId));",
                  "}",
                  "pm.test('Sipariş oluşturuldu', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": {{orderQuantity}} }\n  ],\n  \"paymentMethodToken\": \"{{paymentMethodToken}}\"\n}"
